/// <reference types="vite/client" />

/**
 * Typed environment configuration.
 *
 * This is the ONLY module allowed to read environment variables. Application,
 * feature and UI code must import from here, never read `process.env` or
 * `import.meta.env` directly. `.specify/scripts/bash/check-env-config.sh`
 * enforces that rule.
 *
 * ONE PROJECT, TWO RUNTIMES
 * ----------------------------------------------------------------------------
 * The UI runs in the browser (Vite injects `import.meta.env.VITE_*`), while a
 * non-UI feature such as an API runs under Node (`npm run dev:api`,
 * `tsx src/main.ts`). Those two surfaces do NOT share a global object:
 *
 *   - The browser has `import.meta.env` and NO `process`.
 *   - Node has `process.env` and NO `import.meta.env`.
 *
 * Reading either one unconditionally is exactly how a backend feature boots
 * with `TypeError: Cannot read properties of undefined (reading 'PORT')`.
 * Both surfaces are therefore read behind explicit guards and normalised into
 * one typed object.
 */

type RawEnv = Record<string, string | undefined>;

/**
 * Browser/UI surface. Vite replaces `import.meta.env` statically at build time.
 * Under Node this is `undefined`, hence the fallback instead of a direct read.
 */
const viteEnv: RawEnv = (import.meta.env ?? {}) as RawEnv;

/**
 * Node surface (`npm run dev:api`). Read through `globalThis` on purpose: it
 * keeps this module type-safe in a browser-targeted TypeScript config where
 * `process` is not declared, and it never throws when `process` is missing.
 */
const nodeEnv: RawEnv = (globalThis as { process?: { env?: RawEnv } }).process?.env ?? {};

/**
 * Which surface is running? Vite always defines at least `MODE` in
 * `import.meta.env`; a plain Node process has none. Browser-only settings are
 * therefore required ONLY when this module is executed by Vite — otherwise an
 * API booting under Node would abort on a variable it does not even own.
 */
const isViteRuntime = Object.keys(viteEnv).length > 0;

export interface Env {
  readonly APP_ENV: 'development' | 'test' | 'production';
  readonly PORT: number;
  readonly API_BASE_URL: string;
  readonly ENABLE_ANALYTICS: boolean;
}

/**
 * First non-empty candidate wins. Server keys are resolved from `nodeEnv`
 * first (the Node process is the authority for its own runtime) and from the
 * Vite surface for browser-only keys.
 */
function pick(...candidates: Array<string | undefined>): string | undefined {
  for (const candidate of candidates) {
    if (candidate !== undefined && candidate.trim() !== '') {
      return candidate;
    }
  }
  return undefined;
}

function required(name: string, value: string | undefined): string {
  if (value === undefined || value.trim() === '') {
    throw new Error(`Missing required environment variable: ${name}`);
  }
  return value;
}

function asPort(value: string | undefined): number {
  const fallback = 3000;
  const parsed = Number(value ?? fallback);
  if (!Number.isInteger(parsed) || parsed < 1 || parsed > 65535) {
    throw new Error(`Invalid PORT: ${String(value)} (expected an integer between 1 and 65535)`);
  }
  return parsed;
}

function asBoolean(value: string | undefined, fallback: boolean): boolean {
  if (value === undefined) {
    return fallback;
  }
  return value === 'true';
}

function asAppEnv(value: string | undefined): Env['APP_ENV'] {
  if (value === 'test' || value === 'production') {
    return value;
  }
  return 'development';
}

export const env: Env = {
  APP_ENV: asAppEnv(pick(nodeEnv.APP_ENV, viteEnv.VITE_APP_ENV, viteEnv.MODE)),
  // API port (server keys are not prefixed with VITE_ on purpose: they must
  // never leak into the browser bundle). The runtime entrypoint gate reads this
  // default when `specs/<feature>/runtime.json` declares no port.
  PORT: asPort(pick(nodeEnv.PORT, viteEnv.VITE_PORT)),
  // Browser-only setting: required in the UI build, optional (and often empty)
  // for an API process, which exposes URLs instead of consuming one.
  API_BASE_URL: isViteRuntime
    ? required('VITE_API_BASE_URL', pick(viteEnv.VITE_API_BASE_URL, nodeEnv.API_BASE_URL))
    : (pick(nodeEnv.API_BASE_URL) ?? ''),
  ENABLE_ANALYTICS: asBoolean(pick(viteEnv.VITE_ENABLE_ANALYTICS, nodeEnv.ENABLE_ANALYTICS), false),
} satisfies Env;
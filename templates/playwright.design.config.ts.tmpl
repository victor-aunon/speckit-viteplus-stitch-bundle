import { defineConfig, devices } from '@playwright/test';

/**
 * Playwright Configuration for Stitch Visual Design Audit.
 *
 * Vite+ built-ins vs scripts (https://viteplus.dev/guide/run): `vp dev` ALWAYS
 * starts the built-in Vite dev server, so it is the wrong launcher for a project
 * whose dev server is Next, Nuxt, Astro or Remix. `vp run dev` delegates to the
 * package.json script and falls back to the package manager.
 *
 * Port: PLAYWRIGHT_TEST_BASE_URL wins, then PLAYWRIGHT_PORT, then the app PORT
 * from the environment, and only then the Vite default 5173.
 */
const APP_PORT = process.env.PLAYWRIGHT_PORT || process.env.PORT || '5173';
const BASE_URL = process.env.PLAYWRIGHT_TEST_BASE_URL || `http://localhost:${APP_PORT}`;

export default defineConfig({
  testDir: './tests/design',
  snapshotPathTemplate: '{testDir}/__snapshots__/{testFilePath}/{arg}{ext}',
  /**
   * Never let the app's current render become the baseline. The golden is
   * DERIVED from designs/<screen-id>.html by render-design-goldens.mjs, which
   * runs before Playwright; without this, a missing golden would be written
   * from the implementation and the regression would be blessed.
   */
  updateSnapshots: 'none',
  expect: {
    toHaveScreenshot: {
      /**
       * Overridable so a project can calibrate from measured data instead of
       * inheriting 0.05 blindly:
       *   bash .specify/scripts/bash/verify-stitch-design.sh --calibrate
       */
      maxDiffPixelRatio: Number(process.env.SPECIFY_DESIGN_TOLERANCE ?? 0.05),
      animations: 'disabled',
      caret: 'hide',
      scale: 'css',
    },
  },
  use: {
    baseURL: BASE_URL,
    trace: 'on-first-retry',
  },
  projects: [
    {
      name: 'design-audit-desktop',
      use: {
        ...devices['Desktop Chrome'],
        viewport: { width: 1440, height: 900 },
      },
    },
  ],
  webServer: {
    command: process.env.PLAYWRIGHT_DEV_COMMAND || 'vp run dev || npm run dev',
    url: BASE_URL,
    reuseExistingServer: !process.env.CI,
    timeout: 30000,
  },
});

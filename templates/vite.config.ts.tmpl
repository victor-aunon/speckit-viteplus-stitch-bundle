import react from '@vitejs/plugin-react';
// `vite-plus`, not `vite`: the `lint`, `fmt`, `check`, `test` and `run` blocks are
// Vite+ extensions, and Vite's own `UserConfigExport` does not declare them. With
// `lint.options.typeCheck: true` this file is type-checked, so importing from
// `vite` makes the config fail its own gate with TS2769 ("'lint' does not exist
// in type 'UserConfigExport'"). `vite-plus` is a declared dependency of every
// profile that uses this template, so the import always resolves.
import { defineConfig } from 'vite-plus';

// Never formatted, never linted. Three kinds of file that the agent must not
// touch, for three different reasons:
//
//   .specify/                 Vendored tooling. `check-blast-radius.sh` treats it as
//                          protected, so a formatter pass there is a gate
//                          violation the agent is forbidden to repair. It also
//                          ships in its own style; reflowing it produces a
//                          permanent diff against the bundle.
//   specs/<feature>/evidence/  Written by the gates. The agent may not edit evidence,
//                          and the gates rewrite it on every run, so formatting
//                          it guarantees a fresh diff after every check.
//   specs/<feature>/designs/   The Stitch design master and the goldens the visual
//                          gate compares against. Reformatting it silently moves
//                          the reference the implementation is graded against.
const IGNORED_GENERATED_PATHS = ['.specify/**', 'specs/**/evidence/**', 'specs/**/designs/**'];

export default defineConfig({
  // React Fast Refresh (HMR). @vitejs/plugin-react is a declared dependency;
  // without this line every edit triggers a full page reload and JSX loses
  // React's automatic runtime wiring under Vite+.
  plugins: [react()],

  // Vite+ (vp) Code Quality Configuration
  lint: {
    ignorePatterns: IGNORED_GENERATED_PATHS,
    options: {
      typeAware: true,
      typeCheck: true, // Strict TypeScript type checking
    },
    jsPlugins: [
      '@shadcn/lint', // Tailwind component contract validation
    ],
    rules: {
      // 1. Cyclomatic Complexity and Structure Rules
      'complexity': ['error', 10],
      'max-lines-per-function': ['error', { max: 50, skipBlankLines: true, skipComments: true }],
      'max-depth': ['error', 3],
      'max-params': ['error', 4],

      // 2. Atomic Design & Component Isolation Rules (Max 1 component per file)
      'react/no-multi-comp': ['error', { ignoreStateless: false }],

      // 3. Tailwind Design Rules (@shadcn/lint)
      'shadcn/no-restyle': ['error', { allow: ['layout'] }],
      'shadcn/no-raw-colors': 'error',
      'shadcn/no-arbitrary-values': 'error',
      'shadcn/no-inline-styles': 'error',
    },

    // 4. Clean Architecture Layer Boundary Restrictions (Oxlint overrides)
    //
    // Supported layout (vertical slicing & shared core):
    //   src/features/<slice>/domain/**
    //   src/features/<slice>/application/**
    //   src/features/<slice>/infrastructure/**
    //   src/features/<slice>/ui/**
    //
    // The same dependency rules apply to every slice under src/** and shared src/core/**:
    // - Domain cannot depend on Application, Infrastructure, or UI
    // - Application cannot depend on Infrastructure or UI
    // - Infrastructure cannot depend on UI
    // - UI cannot directly import Infrastructure adapters
    overrides: [
      // Domain layer boundary
      {
        files: ['**/src/**/domain/**', '**/src/core/domain/**'],
        rules: {
          'no-restricted-imports': [
            'error',
            {
              patterns: [
                {
                  group: [
                    '**/application/**',
                    '**/infrastructure/**',
                    '**/ui/**',
                    '**/src/**/application/**',
                    '**/src/**/infrastructure/**',
                    '**/src/**/ui/**',
                  ],
                  message:
                    'Clean Architecture Violation: Domain cannot depend on Application, Infrastructure, or UI (vertical slice rule).',
                },
              ],
            },
          ],
        },
      },
      // Application layer boundary
      {
        files: ['**/src/**/application/**', '**/src/core/application/**'],
        rules: {
          'no-restricted-imports': [
            'error',
            {
              patterns: [
                {
                  group: [
                    '**/infrastructure/**',
                    '**/ui/**',
                    '**/src/**/infrastructure/**',
                    '**/src/**/ui/**',
                  ],
                  message:
                    'Clean Architecture Violation: Application cannot depend on Infrastructure or UI (vertical slice rule).',
                },
              ],
            },
          ],
        },
      },
      // Infrastructure layer boundary
      {
        files: ['**/src/**/infrastructure/**', '**/src/infrastructure/**'],
        rules: {
          'no-restricted-imports': [
            'error',
            {
              patterns: [
                {
                  group: ['**/ui/**', '**/src/**/ui/**'],
                  message:
                    'Clean Architecture Violation: Infrastructure cannot depend on UI (vertical slice rule).',
                },
              ],
            },
          ],
        },
      },
      // UI layer boundary & rules
      {
        files: ['**/src/**/ui/**', '**/src/ui/**'],
        rules: {
          // Omit 50-line limit for UI components to accommodate accessible JSX, ARIA attributes, and presentation states
          'max-lines-per-function': 'off',
          'no-restricted-imports': [
            'error',
            {
              patterns: [
                {
                  group: ['**/infrastructure/**', '**/src/**/infrastructure/**'],
                  message:
                    'Clean Architecture Violation: UI cannot directly import Infrastructure adapters (vertical slice rule).',
                },
              ],
            },
          ],
        },
      },
      // Test suites: omit function length limits for describe/it blocks
      {
        files: [
          '**/*.test.{ts,tsx,js,jsx}',
          '**/*.spec.{ts,tsx,js,jsx}',
          '**/tests/**',
          '**/test/**',
        ],
        rules: {
          'max-lines-per-function': 'off',
        },
      },
      // The vendored audit spec is tooling, not application code: it is
      // materialized from the bundle and the agent may not edit it. Grading it
      // against the application complexity and nesting budget only produces
      // errors nobody is allowed to fix.
      {
        files: ['**/tests/design/**'],
        rules: {
          complexity: 'off',
          'max-depth': 'off',
          'max-lines-per-function': 'off',
        },
      },
    ],
  },
  fmt: {
    ignorePatterns: IGNORED_GENERATED_PATHS,
    // Airbnb / VoidZero style guide standard
    singleQuote: true,
    semi: true,
    trailingComma: 'all',
    tabWidth: 2,
    printWidth: 100,
  },
  // Unit tests run in jsdom, and the accessibility audit under tests/design is
  // driven by `playwright test` — never by vitest. Vitest's default include picks
  // that spec up and dies on `test.describe`, which is exactly what happened in a
  // real run: the agent had to add this block itself, to a file this bundle now
  // protects. Shipping it here is what makes that protection safe.
  test: {
    environment: 'jsdom',
    globals: true,
    exclude: ['**/node_modules/**', '**/dist/**', '**/tests/design/**'],
  },
});
